node_modules/
dist/
.DS_Store
*.local
.vite/
*.tmpdir/
.*.tmp

# Local secrets.
#
# `*.local` above already covers this file; the line is repeated here so that the REASON is written down where
# someone tempted to tighten that rule will read it. THIS REPOSITORY IS PUBLIC. `ARK_API_KEY` lives in
# `.env.local` for `scripts/seedream.py` and the game-asset skill, and committing it would publish a live key.
.env.local

# Dev-server runtime artifacts: pid files and logs are per-machine and are recreated on start.
.devserver.pid
.devserver.log
.devserver.err.log
*.log

# Release archives. Reproducible in under a second with `pnpm build`, so they are not source.
release/

# Screenshots produced by the verification scripts in scripts/.
/screenshot*.png
/shot-*.png
/mobile.png
/zone.png
/measure.png
/d2*.png

# Tooling scratch directories (editor / agent temp workspaces)
.dsh-*/

# Temporary commit-message files.
#
# One pattern rather than an entry per commit: they accumulated to twenty-two near-identical lines,
# which is worse than useless in a file nobody reads closely.
CM*.tmp
commit-msg.tmp
COMMIT_MSG.tmp
MSG.tmp
msg.txt

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Probe artifacts under `.scratch`.
#
# `.scratch/<feature>/issues/*.md` are the ISSUE NOTES and the design docs are tracked; the throwaway half of the
# same directory is measurement scripts and screenshots, and those are deleted after use. `git add -A` swept them
# into the history TWICE, which is what this rule is for: the notes are the thing worth keeping, and everything
# else in there is regenerable in a minute.
.scratch/**/*.mjs
.scratch/**/*.png
.scratch/**/*.py
.scratch/**/*.json
# The asset pipeline's `sheet` writes an `idle-loop.gif` beside every sprite it makes, so a run of the
# game-asset skill drops one per creature into the scratch directory. It was the one extension the four
# rules above missed, and `git status` showed them sitting there ready to be swept in by the next `git add -A`.
.scratch/**/*.gif
