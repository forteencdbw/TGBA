node_modules/
dist/
.DS_Store
*.local
.vite/
*.tmpdir/
.*.tmp

# Local secrets.
#
# `*.local` above already covers this file; the line is repeated here so that the REASON is written down where
# someone tempted to tighten that rule will read it. THIS REPOSITORY IS PUBLIC. `ARK_API_KEY` lives in
# `.env.local` for `scripts/seedream.py` and the game-asset skill, and committing it would publish a live key.
.env.local

# Dev-server runtime artifacts: pid files and logs are per-machine and are recreated on start.
.devserver.pid
.devserver.log
.devserver.err.log
*.log

# Release archives. Reproducible in under a second with `pnpm build`, so they are not source.
release/

# Screenshots produced by the verification scripts in scripts/.
/screenshot*.png
/shot-*.png
/mobile.png
/zone.png
/measure.png
/d2*.png

# Tooling scratch directories (editor / agent temp workspaces)
.dsh-*/

# Temporary commit-message files.
#
# One pattern rather than an entry per commit: they accumulated to twenty-two near-identical lines,
# which is worse than useless in a file nobody reads closely.
CM*.tmp
commit-msg.tmp
COMMIT_MSG.tmp
MSG.tmp
msg.txt

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Probe artifacts under `.scratch`.
#
# `.scratch/<feature>/issues/*.md` are the ISSUE NOTES and the design docs are tracked; the throwaway half of the
# same directory is measurement scripts and screenshots, and those are deleted after use. `git add -A` swept them
# into the history TWICE, which is what this rule is for: the notes are the thing worth keeping, and everything
# else in there is regenerable in a minute.
.scratch/**/*.mjs
.scratch/**/*.png
.scratch/**/*.py

# The two scratch directories whose ENTIRE content is output.
#
# The per-extension rules above kept leaking: every new extension the tooling invented (`.log`, `.binarypb`,
# `.jpg`, `.old`, `.db`, …) became a fresh way for one `git add -A` to sweep hundreds of megabytes into a
# commit -- and it happened a third time, 2284 files and 315 MB, of the driver's screenshots and the asset
# pipeline's reference photos. Neither directory has ever held a tracked file, so ignore the directories and
# stop playing whack-a-mole with the extensions.
.scratch/run-check/
.scratch/asset-pipeline/

# `.mcp.json` is machine-local here, not a shared convention.
#
# It names `http://127.0.0.1:8188` -- a ComfyUI server running on THIS machine -- so a clone would inherit a
# config pointing at a port nobody is listening on. It was untracked, and `git add -A` published it anyway
# because nothing told it not to. The file itself is untouched on disk.
.mcp.json

# Python bytecode caches.
#
# `refs/__pycache__/asset_pipeline.cpython-312.pyc` was tracked, which is worth a line because of what happens
# now: the asset pipeline IMPORTS `refs/asset_pipeline.py`, so every run of it rewrites that cache and dirties the
# working tree -- a file nobody can read, that only matches one Python build, appearing in every `git status`.
# Untracked here; the file itself is untouched on disk.
__pycache__/
*.py[cod]
.scratch/**/*.json
# The asset pipeline's `sheet` writes an `idle-loop.gif` beside every sprite it makes, so a run of the
# game-asset skill drops one per creature into the scratch directory. It was the one extension the four
# rules above missed, and `git status` showed them sitting there ready to be swept in by the next `git add -A`.
.scratch/**/*.gif
