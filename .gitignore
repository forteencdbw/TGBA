node_modules/
dist/
.DS_Store
*.local
.vite/
*.tmpdir/
.*.tmp

# Dev-server runtime artifacts: pid files and logs are per-machine and are recreated on start.
.devserver.pid
.devserver.log
.devserver.err.log
*.log

# Release archives. Reproducible in under a second with `pnpm build`, so they are not source.
release/

# Screenshots produced by the verification scripts in scripts/.
/screenshot*.png
/shot-*.png
/mobile.png
/zone.png
/measure.png
/d2*.png

# Tooling scratch directories (editor / agent temp workspaces)
.dsh-*/

# Temporary commit-message files.
#
# One pattern rather than an entry per commit: they accumulated to twenty-two near-identical lines,
# which is worse than useless in a file nobody reads closely.
CM*.tmp
commit-msg.tmp
COMMIT_MSG.tmp
MSG.tmp
msg.txt

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
