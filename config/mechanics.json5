        "attackSpraySpread": 0.55,
        "attackSpraySeconds": 0.62,
        "attackSprayFromX": 0.55,
        "attackSprayFromY": -1.25,
        "attackSprayBowRatio": 0.09
      },
      // 第 3 关 —— 冠冕水母。
      "boss-jelly": {
        "holdMeters": 330,
        "holdBandRatio": 0.34,
        "holdMinMeters": 90,
        "patrolAmplitude": 0.36,
        "patrolPeriodSeconds": 4.6,
        "seekSpeedFactor": 0.16,
        "radiusRatio": 0.11,
        "colour": 0x53306b,
