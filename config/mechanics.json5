      // 第 6 关 —— 风暴之眼。
      "boss-eye": {
        "holdMeters": 330,
        "holdBandRatio": 0.34,
        "holdMinMeters": 90,
        "patrolAmplitude": 0.36,
        "patrolPeriodSeconds": 4.6,
        "seekSpeedFactor": 0.16,
        "radiusRatio": 0.11,
        "colour": 0x53306b,
        "eyeColour": 0xffd479,
        "armourColour": 0x7a4f9c,
        "weakPointWidthRatio": 0.03,
        "hitFlashColour": 0xffffff,
        "hitFlashStrength": 1,
